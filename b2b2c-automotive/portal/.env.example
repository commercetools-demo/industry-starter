# Copy to .env.local (git-ignored) and fill in. Names only here, never values.

# Project key of the commercetools project (also the Contentools tenant).
CTP_PROJECT_KEY=
# Region auth URL, e.g. https://auth.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=
# Region API URL, e.g. https://api.europe-west1.gcp.commercetools.com
CTP_API_URL=

# --- Frontend API client (buying through the as-associate chain) ---
# Frontend (non-admin) API client id.
CTP_CLIENT_ID=
# Frontend API client secret. Server only. Never NEXT_PUBLIC_.
CTP_CLIENT_SECRET=
# Space separated scopes. Each one is explained below.
# view_project_settings : read currencies, countries and languages for COUNTRY_CONFIG checks
# view_published_products : product data shown in the portal catalog screens
# view_categories : category tree for assortment and filters
# view_stores : read the signed-in user's stores and the store switcher
# view_product_selections : read a store's assortment (product selection)
# view_associate_roles : read associate roles to derive portal permissions
# view_business_units : list the signed-in customer's business units and read a unit's associates and role assignments
# view_types : read custom type definitions (vehicle fitment, store settings)
# manage_customers : sign-in, account area and customer lookup for the reseller's staff
# manage_orders : read and update the reseller's orders
# manage_quotes : quote lifecycle for the signed-in business unit
# manage_quote_requests : quote requests for the signed-in business unit
# view_quotes : read quotes
# manage_business_units : company profile, addresses and invitations through the as-associate business unit endpoints (Admin and Buyer roles must be buyer assignable, see seed requests)
CTP_SCOPES=

# --- Seller-admin API client (seller-side administration behind authorizeStore) ---
# Seller-admin API client id. Imported only from app/api/seller/**, lib/ct/seller/** and lib/contentools/jwt.ts.
CTP_ADMIN_CLIENT_ID=
# Seller-admin API client secret. Server only. Never NEXT_PUBLIC_.
CTP_ADMIN_CLIENT_SECRET=
# Space separated scopes. Assortment, price, discount and tailoring scopes are added by workstreams T and U, each with a reason.
# manage_key_value_documents : read and refresh the Contentools JWT custom object
# manage_stores : store name, logo and favicon, location fields and the supply and distribution channel lists (branches)
# manage_channels : create and edit branch channels (address, geo location, branch-info)
# view_types : read the store-settings and branch-info custom types before writing custom fields
# view_orders : order counts and revenue per sales channel for the Channels tab
# manage_products : branch stock: inventory entries on the branch supply channel (inventory has no scope of its own)
# view_standalone_prices : read the branch prices shown in the branch stock drawer (writes go through the price module)
# view_recurring_orders : active subscriptions and renewals on the dashboard (orders, reviews and inventory reads there use view_orders and manage_products above)
# manage_product_selections : catalog: add and remove products in the store's own selection (the master selection is read only)
# view_categories : catalog: category tree for assortment filters
# manage_standalone_prices : catalog: create, change and suspend the store retail and branch prices (also covers the price import)
# manage_product_discounts : catalog: the store's own product discounts
# manage_cart_discounts : catalog: the store's own cart discounts
# manage_discount_codes : catalog: codes of the store cart discounts and their redemption counts
# manage_import_containers : W: CSV product import through the Import API (the Import API host is derived from CTP_API_URL)
# view_customers : W: audience rules read the marketing consent and the order history of the store's customers (counts only are shown)
# manage_orders : V: mark an order delivered and record and move returns (return info and return item fields)
# view_payments : V: read the Payment of an order to see the Charge and the Refund transactions Checkout added
# manage_checkout_payment_intents : V: ask commercetools Checkout to refund a payment (Payment Intents API, scope requested as manage_checkout_payment_intents:<projectKey>)
# manage_recurring_orders : V: pause, resume, skip and cancel recurring orders (subscriptions)
# view_states : V: resolve the review states review-published and review-hidden
CTP_ADMIN_SCOPES=

# --- Provisioning API client (registration endpoint only) ---
# Provisioning API client id.
CTP_PROVISION_CLIENT_ID=
# Provisioning API client secret. Server only. Never NEXT_PUBLIC_.
CTP_PROVISION_CLIENT_SECRET=
# Space separated scopes.
# manage_business_units : create the pending reseller business unit and its first administrator
# manage_customers : delete the just-created customer when creating the business unit fails (compensation)
# view_stores : resolve a store when the operator assigns it while approving
# view_associate_roles : resolve the mau-role-admin role for the first administrator
CTP_PROVISION_SCOPES=

# --- Session and Contentools ---
# Session cookie signing secret, at least 32 random characters (openssl rand -base64 48).
SESSION_SECRET=
# Origin of the Contentools service, no trailing slash needed.
CONTENTOOLS_ORIGIN=
# Shared secret of the "Shop as customer" handoff token (HS256), at least 32 random characters (openssl rand -base64 48). The SAME value must be set in the storefront. Server only. Absent: Shop as customer answers "not set up".
IMPERSONATION_SECRET=
# Public origin of the shopper storefront (read-only address, theme preview iframe, share links, QR codes). Development default http://localhost:3000.
# BUILD TIME: next.config.ts bakes it into the CSP frame-src, so set it in the build environment. A release build (RELEASE=1) fails scripts/check-build-env.mjs without it (a bare https origin).
STOREFRONT_ORIGIN=
# Seconds until a saved theme shows on the storefront; must equal the storefront theme cache lifetime (THEME_TTL_SECONDS, default 60).
STOREFRONT_THEME_CACHE_SECONDS=
# User-Agent sent to OpenStreetMap Nominatim for the "Find coordinates" button (usage policy: identify the app, include a contact). Optional.
GEOCODER_USER_AGENT=
# Set to 1 in development to log every proxied Contentools path (no headers, no bodies) so the allow-list can be extended with a test.
CONTENTOOLS_PROXY_LOG=
# Development only, ignored in production: false makes the /api/contentools proxy rewrite a foreign store segment instead of refusing it (workstream X test D02).
PROXY_STRICT_STORE=

# --- Demo and development switches (workstream R); never enable in production ---
# Set to true to show the demo account picker on the sign-in card. Non-production only: a production build with this on fails the build check.
DEMO_LOGIN_ENABLED=
# Set to true to make a registered reseller wait until a Malva operator sets its business unit Active (the pending-approval screen). Absent or anything else: the unit status is not checked and a user whose unit has a store signs in at once.
PORTAL_REQUIRE_APPROVAL=
# Set to true to turn on the Store Copilot (the assistant panel and its /api/copilot routes). Absent or anything else: the panel is not rendered and the routes answer 404.
PORTAL_COPILOT_ENABLED=
# Password of the seeded demo accounts (same value as SEED_DEMO_PASSWORD). Server only, never sent to the browser.
DEMO_LOGIN_PASSWORD=
# Set to true to enable the on-screen password reset (no email is ever sent, owner Q-P01). Anyone who knows an email can reset that account: demo and development only. Absent or false: routes answer 404 and the page shows no form.
# One spelling in both apps (Q-X10): only true or false; any other value (for example the old "on") fails scripts/check-demo-reset.mjs. A production build with true also needs DEMO_RESET_ACKNOWLEDGED=true.
DEMO_ONSCREEN_RESET=
# Set to on in development to use the fixture session and fixture users instead of commercetools (switch role with /api/dev/session?as=adminA|buyerA|adminB|pending|none). Ignored in production.
PORTAL_DEV_FIXTURES=
# Store performance block of the dashboard (Admin only). Absent or on: shown. off: hidden and the endpoint answers 404.
PORTAL_STORE_PERFORMANCE=
# Attack harness switch and Contentools JWT canary (workstream X). Leave EMPTY: scripts/check-no-attack-mode.mjs fails a release that sets them. The canary replaces the stored Contentools JWT only outside production or with ATTACK_MODE=1.
ATTACK_MODE=
CONTENTOOLS_JWT_CANARY=
