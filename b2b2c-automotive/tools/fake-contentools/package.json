{
  "name": "fake-contentools",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Dependency-free fake of the Contentools HTTP API (theme, Puck pages and contents, upload-file) for storefront and portal tests. Makes no commercetools calls.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "tsx src/main.ts",
    "start:4011": "PORT=4011 tsx src/main.ts",
    "start:stub": "STUB_MODE=1 PORT=4010 tsx src/main.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "fixture": "tsx scripts/export-theme-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
