# Seed admin API client. Values go in seed/.env.local, which is git-ignored. Never paste them in chat.
# The seed writes: project settings, product types, categories, products, prices, inventory, tax categories, zones,
# shipping methods, channels, types, stores, product selections, reviews, product tailoring, business units,
# associate roles, customers, discounts, recurrence policies and custom objects. Cleanup also deletes sample data.
# Use the narrowest scopes that work. The unprefixed names AUTH_URL, API_URL, CLIENT_ID, CLIENT_SECRET, SCOPES are
# accepted as fallbacks for the SEED_CTP_ ones.
SEED_CTP_PROJECT_KEY=
SEED_CTP_AUTH_URL=
SEED_CTP_API_URL=
SEED_CTP_CLIENT_ID=
SEED_CTP_CLIENT_SECRET=
SEED_CTP_SCOPES=

# The project key typed a second time on purpose: a mismatch aborts the run (guards against a pasted wrong project).
EXPECTED_PROJECT_KEY=
# Password given to the synthetic demo users (*@example.com). At least 10 characters.
SEED_DEMO_PASSWORD=
# Optional: Image source Next.js build id used by seed:images (default is in src/images.ts).
# IMAGE_SOURCE_BUILD_ID=
