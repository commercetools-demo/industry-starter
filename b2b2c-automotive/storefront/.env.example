# Names only. Copy to .env.local and fill in; never commit real values.
# Project key of the commercetools project (also the Contentools tenant).
CTP_PROJECT_KEY=
# Region auth URL, e.g. https://auth.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=
# Region API URL, e.g. https://api.europe-west1.gcp.commercetools.com
CTP_API_URL=
# Frontend (non-admin) API client id.
CTP_CLIENT_ID=
# Frontend API client secret. Server only. Never NEXT_PUBLIC_.
CTP_CLIENT_SECRET=
# Space separated scopes. Each one is explained below.
# view_project_settings   : read currencies, countries and languages for COUNTRY_CONFIG checks
# view_published_products : product pages and search (published projection)
# view_products           : Product Search (listing and search), product type labels and stock (inventory entries)
# view_standalone_prices  : the standalone prices of the listing, product page and cart (all prices are standalone)
# view_recurrence_policies : the frequencies of "Subscribe and save" on the product page
# view_categories         : category tree and category pages
# view_stores             : resolve the store from the URL path
# view_product_selections : the store's assortment (product selection) for search filters
# view_shipping_methods   : shipping choices at checkout (matching-cart: the delivery options and the free-shipping threshold of the cart)
# view_cart_discounts     : name each applied discount on the cart (expanded cart discount and product discount references)
# view_discount_codes     : state of a promo code on the cart (applied or not applied, and why)
# view_types              : read custom type definitions (vehicle fitment, garage)
# view_key_value_documents : read the vehicle table (custom objects, container mau-vehicles)
# manage_key_value_documents : shop as customer: mark the single-use handoff record (custom object, container malva-impersonation) active or ended
# create_anonymous_token  : anonymous sessions and carts
# manage_customers        : sign-in, registration, account area
# manage_orders           : place and read the shopper's orders
# manage_sessions         : create Checkout sessions for the hosted checkout
# manage_recurring_orders : the account's Subscriptions page (list, skip, pause, resume, change frequency, cancel) and the subscription line of an order
# manage_payment_methods  : the account's saved payment methods (list and delete)
CTP_SCOPES=
# Session cookie signing secret, at least 32 random characters (openssl rand -base64 48).
SESSION_SECRET=
# Signs the private link of an order confirmation page (workstream P), at least 32 random characters, different from SESSION_SECRET
# (a leaked order link must not be a session secret). Nothing else uses it; no email is ever sent.
ORDER_ACCESS_SECRET=
# Origin of the Contentools service, no trailing slash needed. A trailing /service is ignored (the app adds /service/<store>/... itself).
CONTENTOOLS_ORIGIN=
# Store picker address search (Nominatim, called only from the server through /api/store-context/geocode).
# GEOCODER=off disables it (the picker then filters by text only) and makes NOMINATIM_CONTACT optional.
GEOCODER=
# Defaults to the public instance https://nominatim.openstreetmap.org; point to a self-hosted one for real traffic.
GEOCODER_URL=
# Required unless GEOCODER=off: an e-mail address or URL that identifies this site in the User-Agent (usage policy).
NOMINATIM_CONTACT=
# Optional, comma separated https origins allowed in the Content-Security-Policy img-src (product photos, logos), for example
# https://your-loyalty-free-image-source.com. Only the OpenStreetMap tile host is allowed by default (lib/csp.ts).
# Product photos go through the Next.js image optimizer (any https host, next.config.ts), so this list only matters for images loaded directly by the browser, for example
# https://your-loyalty-free-image-source.com, https://placehold.co and the host Contentools returns for uploaded files. A missing host shows
# the card's "No photo" slot, never an error.
CSP_IMG_HOSTS=
# Plate and VIN lookup provider. Only "stub" exists (the mock; no real decoding service). Empty means stub.
VEHICLE_PROVIDER=
# true or false: show the Plate and VIN tabs of the vehicle finder. Empty means on outside production, off in production.
VEHICLE_LOOKUP_ENABLED=
# Set to true to show the mock lookup in a PRODUCTION build (scripts/check-vehicle-provider.mjs fails the build otherwise).
VEHICLE_MOCK_ACKNOWLEDGED=
# "Subscribe and save" on the product page (workstream M): on unless this is false (workstream O sets false when the installed
# Stripe connector cannot process recurring orders).
SUBSCRIPTIONS_PURCHASE_ENABLED=
# Product reviews written on the product page (workstream M): off unless true. Creating a review needs the scope
# manage_products on the API client (commercetools has no narrower scope; OA row M-OA-1), so turn it on only after that decision.
REVIEW_SUBMISSION_ENABLED=
# Key of the commercetools Checkout Application (owner action OA-05: Stripe connector plus a Complete Checkout Application).
# Required in production; empty in development shows "Checkout is not set up yet" (the dev helper below still works). The key is not a secret.
# The Application's payment return URL must be https://<origin>/checkout/return and its origin URLs must include this site.
# The Content-Security-Policy that lets the hosted Checkout and Stripe load is fixed when `next build` runs (next.config.ts), so this key
# and CTP_API_URL (its region) must be set at build time too, not only at runtime.
CTP_CHECKOUT_APP_KEY=
# true: DEVELOPMENT ONLY. The checkout page offers "Create test order", which creates an order from the cart WITHOUT a payment so the
# confirmation page and the account can be checked before Stripe exists. Refused (404, startup error) when NODE_ENV is production.
CHECKOUT_DEV_COMPLETE=
# DEVELOPMENT ONLY, rehearsal without Stripe: base URLs of a local stand-in for the Checkout Sessions API and for the hosted Checkout app
# (the Browser SDK accepts a URL in place of a region). Both must be set; they are ignored when NODE_ENV is production.
CHECKOUT_DEV_SESSIONS_URL=
CHECKOUT_DEV_APP_URL=
# "Shop as customer" (workstream V-06): the HS256 key shared with the portal, at least 32 random characters, the SAME value as the portal's
# IMPERSONATION_SECRET and different from SESSION_SECRET. Empty or shorter turns the feature off (/api/impersonate answers the not-found page).
IMPERSONATION_SECRET=
# Demo login (workstream Q-13a): true shows a "Demo account" picker on the sign-in page that lists the store's seeded demo shoppers
# (malva-customer.isDemo) and signs one in with DEMO_LOGIN_PASSWORD. NEVER in production: scripts/check-no-demo-login.mjs fails a production build
# (NODE_ENV, VERCEL_ENV or CONTEXT production) that sets it, and the app ignores it in production.
DEMO_LOGIN_ENABLED=
# The demo shoppers' password: the same value as the seed's SEED_DEMO_PASSWORD. Server only; never in the browser bundle (also checked by the script above).
DEMO_LOGIN_PASSWORD=
# Password reset on screen (workstream Q-04; the project sends no email): true shows the reset link on the page, false turns the reset off.
# One spelling in both apps (Q-X10): only true or false; any other value (for example the old "on") fails scripts/check-demo-reset.mjs.
# Empty means on outside production and off in production (the portal: empty is always off). SECURITY: with it on, anyone who knows an email address can reset that account's password.
DEMO_ONSCREEN_RESET=
# Needed with DEMO_ONSCREEN_RESET=true in a PRODUCTION build (scripts/check-demo-reset.mjs): the owner's acknowledgement of the risk above (M-Q02).
DEMO_RESET_ACKNOWLEDGED=
# Origin of the Partner Portal (https://portal.example.com). The portal live preview frames the storefront; this origin is added to frame-ancestors (workstream X). Empty: only this site may frame it (development default http://localhost:3001).
# BUILD TIME: next.config.ts bakes it into the headers, so set it in the build environment. A release build (RELEASE=1) fails scripts/check-build-env.mjs without it (and without CSP_IMG_HOSTS above).
PORTAL_ORIGIN=
# Client address for the rate limiters (sign-in, registration, reset, order claim, geocoder, vehicle lookup; workstream X, Q-X09). A client can send any x-forwarded-for, so the
# FIRST value is never trusted: the default is the entry the host's proxy appended (rightmost). CLIENT_IP_HEADER names a single-value header your host sets (Netlify:
# x-nf-client-connection-ip; Vercel: x-real-ip). TRUSTED_PROXY_HOPS is the number of proxies that append to x-forwarded-for (default 1). Without a header the key is "unknown" (one shared bucket).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
# Attack harness switch and Contentools JWT canary (workstream X). Leave EMPTY: scripts/check-no-attack-mode.mjs fails a release that sets them.
ATTACK_MODE=
CONTENTOOLS_JWT_CANARY=
