# Seed admin API client. Names only: real values go in seed/.env.local, which is git-ignored. Never paste them in chat.
# The seed writes: project settings, tax categories, zones, shipping methods, product types, categories, products and
# prices, inventory, channels, custom types, states, recurrence policies, discounts and codes, customers, shopping
# lists and reviews. Cleanup also deletes sample data listed in a reviewed manifest.
# Use the narrowest scopes that work (manage the resources above plus view/manage project settings).
SEED_CTP_PROJECT_KEY=
SEED_CTP_AUTH_URL=
SEED_CTP_API_URL=
SEED_CTP_CLIENT_ID=
SEED_CTP_CLIENT_SECRET=
SEED_CTP_SCOPES=

# The project key typed a second time on purpose: a mismatch aborts the run (guards against a pasted wrong project).
EXPECTED_PROJECT_KEY=

# Password given to the synthetic demo customers (*@example.com). At least 10 characters.
SEED_DEMO_PASSWORD=

# Optional: JSON endpoint for seed:images, shaped like sample-data/image.json (provided by the owner later, OA-03).
IMAGE_SOURCE_URL=
