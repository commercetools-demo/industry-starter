    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "jose": "^6.2.13",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "swr": "^2.5.1"
