# commercetools project key. Also typed again as EXPECTED_PROJECT_KEY below.
CTP_PROJECT_KEY=
# Must equal CTP_PROJECT_KEY. The server refuses to start otherwise.
EXPECTED_PROJECT_KEY=
# Region auth URL, for example https://auth.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=
# Region API URL, for example https://api.europe-west1.gcp.commercetools.com
CTP_API_URL=
# Frontend (non-admin) API client. Server only. Never NEXT_PUBLIC_.
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
# Space separated scopes, each as <scope>:<project key>. Reasons:
# view_project_settings : read countries, currencies and languages
# view_products : Product Search, channels (stores), inventory, reviews read
# view_published_products : product pages
# view_categories : category tree and pages
# view_shipping_methods : delivery options per market
# view_tax_categories : tax display
# view_types : custom type definitions
# view_cart_discounts : discount messages
# view_discount_codes : discount code validation
# create_anonymous_token : guest sessions and carts
# manage_customers : sign in, registration, account
# manage_orders : place and read orders
# manage_shopping_lists : saved items
# manage_sessions : hosted Checkout payment sessions
# view_payment_methods : saved cards list (account area)
# manage_payment_methods : remove a saved card, set the default (account area)
# manage_recurring_orders : read and change the customer's subscriptions (recurring orders)
# view_recurrence_policies : read the delivery intervals (recurrence policies)
CTP_SCOPES=
# At least 32 random characters. Generate: openssl rand -base64 48
SESSION_SECRET=
# Demo sign-in dropdown (D-040). Server only. Set DEMO_LOGIN_ENABLED=true on the demo project; the owner confirms before any public launch.
DEMO_LOGIN_ENABLED=
# Same value as the seed SEED_DEMO_PASSWORD (the password of the seeded demo customers). Never NEXT_PUBLIC_.
DEMO_LOGIN_PASSWORD=
# Public site origin (not a secret) for the sitemap, robots.txt and canonical links, for example https://shop.example.com
NEXT_PUBLIC_SITE_URL=
# Contact form receiver (helpdesk, Slack or Teams incoming webhook). Server only. Empty: the form reports "not sent".
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Optional receiver for FAQ helpful votes. Empty: one log line per vote.
FEEDBACK_WEBHOOK_URL=
# Review writes (D-027, workstream M): a second, isolated API client with scope manage_products:<project key>. Server only.
# Empty: reading reviews works, writing a review answers "service unavailable".
CTP_REVIEWS_CLIENT_ID=
CTP_REVIEWS_CLIENT_SECRET=
# Optional, space separated. Default: manage_products:<CTP_PROJECT_KEY>
CTP_REVIEWS_SCOPES=
# Checkout (workstream K): the key of the commercetools Checkout Application (type Complete Checkout, OA-K-a). Not secret. Empty: the pay step answers "service unavailable".
CTP_CHECKOUT_APP_KEY=
# Local mock only (scripts/mock-ct-server.mjs): the base URL of the Sessions API stand-in, for example https://localhost:9443. Leave empty everywhere else.
CTP_SESSION_URL=
