# Graphify AI graph + cache specific ignores
# Catch-all so a graphify-out created in a submodule (e.g. by running graphify
# from that subdirectory instead of repo root) is never tracked, since the
# more specific rules below are anchored to the repo root only.
graphify-out/cache/*
graphify-out/manifest.json
graphify-out/cost.json
graphify.db
!graphify-out/graph.html
!graphify-out/graph.json
graphify-out/.graphify_root
