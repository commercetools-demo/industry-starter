# Local runs only. On Connect these are injected by the platform (inheritAs.apiClient). Never commit .env.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
# Space separated, each as <scope>:<project key>
CTP_SCOPE=
CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com
# Optional. Default "*".
CORS_ALLOWED_ORIGIN=*
PORT=8080
