# ─── Environment files — NEVER commit these ──────────────────────────────────
# Matches .env in any directory (site/.env, tools/.env, etc.)
.env
.env.local
.env.*.local
.env.production
.env.*
!.env.example
!site/.env.example
.env.test
# Belt-and-suspenders: explicit paths in case of git add --force
site/.env
tools/.env

# ─── Claude Code worktrees (parallel sessions) ───────────────────────────────
# `claude --worktree <name>` checks out isolated worktrees here; keep them out
# of the main checkout's git status. See .worktreeinclude for env-copy config.
.claude/worktrees/

# ─── Dependencies ─────────────────────────────────────────────────────────────
**/node_modules/

# ─── Next.js ──────────────────────────────────────────────────────────────────
site/.next/
site/out/
site/.vercel

# ─── Build artifacts ──────────────────────────────────────────────────────────
site/build/
*.tsbuildinfo
site/next-env.d.ts

# ─── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
*.pem

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# Local Netlify folder
.netlify
test/playwright-report/
test-results/

# Playwright gate session (test/gate-setup.ts) — a live cookie, regenerated each run
test/.auth/

# direnv file used to connect the commerce MCP (contains secrets - never commit)
.envrc
.env.seed
.env.seed.*

# decor catalog backup (D-048)
plan/backup/

# Captured browser request for the image search (contains live session cookies); never commit
site/scripts/pexels/
