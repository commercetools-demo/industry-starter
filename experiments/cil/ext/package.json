{
  "name": "ext",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "commercetools integration-layer extension build --all",
