# Seed admin API client (OA-01). Values go in seed/.env.local, which is git-ignored. Never paste them in chat.
# The seed writes: project settings, products, categories, product types, types, tax categories, zones, shipping
# methods, stores, product selections, associate roles, customers, business units, custom objects, and (cleanup only)
# carts, orders, inventory. Use the narrowest scopes that work; avoid an unrestricted admin client if possible.
SEED_CTP_PROJECT_KEY=
SEED_CTP_AUTH_URL=
SEED_CTP_API_URL=
SEED_CTP_CLIENT_ID=
SEED_CTP_CLIENT_SECRET=
SEED_CTP_SCOPES=
# The project key typed a second time on purpose: a mismatch aborts the run (guards against a pasted wrong project).
EXPECTED_PROJECT_KEY=
# Password given to the synthetic demo users (*@example.com). At least 10 characters.
SEED_DEMO_PASSWORD=
