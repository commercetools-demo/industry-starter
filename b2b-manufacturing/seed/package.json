{
  "name": "malva-seed",
  "private": true,
  "type": "module",
  "description": "Idempotent seed scripts for the Malva commercetools project (services, roles, store, demo companies, images).",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "configure": "tsx src/configure-project.ts",
