  "dependencies": {
    "@commercetools/platform-sdk": "^8.0.0",
    "@commercetools/ts-client": "^4.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
