{
  "name": "malva-healthcare-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed": "tsx scripts/seed/seed.ts",
    "seed:verify": "tsx scripts/seed/verify.ts",
    "seed:images": "tsx scripts/seed/update-images.ts",
    "seed:cleanup": "tsx scripts/seed/cleanup-sample.ts",
    "seed:reset": "tsx scripts/seed/reset-seed.ts",
    "seed:inventory": "tsx scripts/seed/inventory-project.ts",
    "seed:wait": "tsx scripts/seed/wait-for-search.ts",
        "lint": "eslint && oxlint -c eslint/oxlint.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && node scripts/check-versions.mjs && node scripts/check-token-parity.mjs && node scripts/gen-lint-allowlist.mjs --check && node scripts/check-tracked-files.mjs && npm run test",
    "verify:build": "npm run check && npm run build && node scripts/check-bundle.mjs && node scripts/check-no-health-in-release.mjs"
  },
  "dependencies": {
    "@commercetools/platform-sdk": "^8.27.0",
    "@commercetools/ts-client": "^4.10.0",
    "jose": "^6.2.12",
    "next": "^16",
    "next-intl": "^4.14.9",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
