# Copy to .env.local and fill in. NEVER commit .env.local. All variables are
# server-only: do not add a NEXT_PUBLIC_ prefix to any of them.

# commercetools project (Merchant Center > Settings > Developer settings)
CTP_PROJECT_KEY=
CTP_AUTH_URL=
CTP_API_URL=

# API client used by the storefront BFF (server-side only)
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=

# Space-separated scopes, each as "scope:<project-key>". Least privilege only.
# Scope justification (why the BFF needs each one):
#   view_products / view_published_products  doctor, medication and lab catalogue pages
#   view_categories                          navigation and listing filters
#   view_stores / view_shipping_methods      store scoping and shipping options at checkout
#   view_tax_categories                      tax on Rx medicine and consultations
#   view_cart_discounts / view_discount_codes  promotions shown in cart
#   view_types                               custom type lookups for custom fields
#   manage_customers                         sign-up, sign-in, profile and address book
#   manage_orders                            carts and orders (carts are covered by this scope)
#   manage_payments                          payment objects for Checkout payment-only mode
#   manage_sessions                          cart and checkout sessions (Frontend client scope; spec requirement)
#   manage_shopping_lists                    saved lists
#   manage_key_value_documents               Custom Objects: availability, bookings, clinical stand-in
CTP_SCOPES=

# Session cookie signing key (jose HS256). At least 32 random characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
