# Copy to .env.local and fill in. NEVER commit .env.local. All variables are
# server-only: do not add a NEXT_PUBLIC_ prefix to any of them.

# commercetools project (Merchant Center > Settings > Developer settings)
CTP_PROJECT_KEY=
CTP_AUTH_URL=
CTP_API_URL=

# API client used by the storefront BFF (server-side only)
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=

# Space-separated scopes, each as "scope:<project-key>", for example "view_products:spec-test-b2c-healthcare".
# Least privilege only. The list = the commercetools B2C storefront template + what recurring orders, recurrence policies and
# recurring prices need + Custom Objects (D-036) + what the code in lib/ct calls (checked by lib/ct/scopes.test.ts, which also fails
# on a duplicate or a scope without a reason). One scope per line below: name, then why the BFF needs it.
#
# --- B2C storefront template baseline
#   view_published_products    published product projections: doctor and medicine pages, home, listings
#   view_products              Product Search (doctor list, /search), inventory reads (shelf life), review reads; also product types and channels
#   view_categories            navigation and listing filters
#   view_stores                store scoping of carts and prices
#   view_shipping_methods      shipping options at checkout and the same-day claim on the home page
#   view_tax_categories        tax on Rx medicine and consultations
#   view_cart_discounts        promotions applied to the cart
#   view_discount_codes        discount codes entered in the cart
#   view_types                 custom type lookups for custom fields (prescription line, patient, order metadata)
#   manage_customers           sign-up, sign-in, password reset, email verification, profile and address book
#   manage_orders              carts and orders (covers Carts and Orders; also Zones for the shipping check)
#   manage_payments            payment objects for Checkout and tender payments
#   manage_sessions            cart and checkout sessions (Frontend client scope; spec requirement)
#   manage_shopping_lists      saved shopping lists (the medicine lists on the account page)
# --- added for this storefront (D-036)
#   manage_checkout_payment_intents  release (cancel) an authorized payment when an order cannot be placed
#   manage_recurring_orders    auto-refill: read, create, pause, resume, skip, change and cancel recurring orders (covers viewing them)
#   view_recurrence_policies   the cadences (mlv-monthly, mlv-quarterly) a refill line references (recurring prices are Embedded Prices, read with view_products)
#   manage_payment_methods     saved payment methods: list descriptors, set default, remove
#   manage_key_value_documents  Custom Objects (containers malva-*): availability, bookings, clinical stand-in, rate limits, order attempts, ledgers, refill log, retention
#   view_project_settings      getProjectSettings: countries and currencies for the region switcher and /api/locale
#   view_states                order state keys read through expand on orders (the order timeline)
# Scopes deliberately NOT requested (standalone prices, the *me* password-flow scopes, admin scopes) are listed in plans/LIVE-TODOS.md section 3.1.
CTP_SCOPES=

# Session cookie signing key (jose HS256). At least 32 random characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public origin of the site (canonical URLs, sitemap, robots). Optional; defaults to http://localhost:3000.
SITE_URL=

# Auto-refill flag. Workstream T ships auto-refill (recurring orders), so the example is on: the home page line
# "Auto-refills you can pause anytime" and the "Auto-refill this order" button show only when this is true. Set it only
# where the recurring-order scopes below are granted and the scheduled check runs. Optional; defaults to off.
AUTO_REFILL_ENABLED=true

# commercetools Checkout (payment-only mode, D-026). The key of the Checkout Application created in the Merchant
# Center (Checkout > Applications). Not a secret, but server-only like the rest. Without it the payment card shows
# "Payment is not available right now" and no order can be placed. The Stripe connector is configured in the Merchant
# Center (OA-04); no Stripe key belongs in this project.
CTP_CHECKOUT_APP_KEY=

# Development only: an ISO instant used instead of the clock for the same-day cut-off (14:00 America/New_York),
# e.g. 2026-10-08T09:00:00-04:00. Ignored when NODE_ENV is production.
SAME_DAY_NOW_OVERRIDE=

# Auto-refill scheduled check (workstream T). A shared secret (16+ random characters) between the Netlify scheduled
# function `auto-refill-run` and POST /api/internal/auto-refill-run; the route is disabled (503) without it.
# Set the same value in the app and in the Netlify function environment. Generate with: openssl rand -base64 32
AUTO_REFILL_RUN_SECRET=
# Development only (workstream U): set to 1 to make the demo funding resolver fail, so the "Cover unresolved" state and
# the disabled Checkout can be seen. Ignored when NODE_ENV is production.
RESOLVER_FORCE_FAIL=

# Shared secret for the monthly allowance reload (workstream U). The Netlify scheduled function sends it in the
# x-malva-reload-secret header to the guarded reload function; without it the reload endpoint is closed (503).
# Generate with: openssl rand -base64 32
RELOAD_ALLOWANCES_SECRET=

# Shared secret for the daily retention run (workstream X). The Netlify scheduled function sends it in the
# x-malva-retention-secret header to the guarded `retention` function; without it (or under 16 characters) the function
# is closed (503). Generate with: openssl rand -base64 32
RETENTION_SECRET=
