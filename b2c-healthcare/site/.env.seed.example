# Copy to .env.seed.local (git-ignored) for the seed scripts only. These are NOT
# read by the storefront. Never commit values.

# Admin API client used only by the seed scripts (needs manage scopes; never reuse the storefront client).
# The scripts REFUSE to run unless SEED_CTP_PROJECT_KEY is exactly spec-test-b2c-healthcare (and the API reports the same key).
#
# SEED_CTP_SCOPES = space-separated "scope:spec-test-b2c-healthcare". Simplest: manage_project:spec-test-b2c-healthcare (everything below
# in one scope). The narrow list, one scope per line with the script that needs it (lib/ct/scopes.test.ts checks: no duplicate, a reason each):
#   manage_products             seed, reset, cleanup, images: products, product types (changeIsSearchable), channels, inventory, reviews; Product Search for seed:wait
#   manage_categories           seed, reset, cleanup: categories
#   manage_types                seed, reset: custom types (prescription line, patient, order meta, review meta, inventory meta, list line)
#   manage_states               seed, reset, cleanup: order states and transitions
#   manage_shipping_methods     seed, reset, cleanup: shipping methods
#   manage_tax_categories       seed, reset, cleanup: tax categories
#   manage_stores               cleanup-sample: deletes sample stores
#   manage_zones                seed, reset, cleanup: the same-day zone (and the sample zones)
#   manage_orders               cleanup and reset --include-customers: carts and orders; seed:advance order states
#   manage_customers            seed: demo patients; reset --include-customers and privacy scripts: erase customers (dataErasure)
#   manage_key_value_documents  seed, reset: Custom Objects (all malva-* containers)
#   manage_shopping_lists       reset --include-customers, privacy scripts: customers' shopping lists
#   manage_payments             reset --include-customers, privacy scripts: payments
#   manage_recurring_orders     reset --include-customers: deletes customers' recurring orders (dataErasure)
#   manage_recurrence_policies  seed, reset: recurrence policies (mlv-monthly, mlv-quarterly)
#   manage_quotes               privacy scripts (erase and access): quotes of a customer
#   manage_quote_requests       privacy scripts: quote requests of a customer
#   manage_staged_quotes        privacy scripts: staged quotes of a customer
#   manage_business_units       privacy scripts: business units a customer is an associate of
#   manage_discount_codes       privacy scripts: discount codes of a customer
#   view_messages               privacy scripts: messages of a customer
#   view_project_settings       every script: reads the project to check its key (the guard)
SEED_CTP_PROJECT_KEY=
SEED_CTP_AUTH_URL=
SEED_CTP_API_URL=
SEED_CTP_CLIENT_ID=
SEED_CTP_CLIENT_SECRET=
SEED_CTP_SCOPES=

# Password given to the synthetic test patients created by the seed
SEED_PATIENT_PASSWORD=
