# Copy to .env.seed.local (git-ignored) for the seed scripts only. These are NOT
# read by the storefront. Never commit values.

# Admin API client used only by the seed scripts (needs manage scopes)
SEED_CTP_PROJECT_KEY=
SEED_CTP_AUTH_URL=
SEED_CTP_API_URL=
SEED_CTP_CLIENT_ID=
SEED_CTP_CLIENT_SECRET=
SEED_CTP_SCOPES=

# Password given to the synthetic test patients created by the seed
SEED_PATIENT_PASSWORD=
