# Copy to .env.seed.local (git-ignored) for the seed scripts only. These are NOT
# read by the storefront. Never commit values.

# Admin API client used only by the seed scripts (needs manage scopes)
# The scripts REFUSE to run unless SEED_CTP_PROJECT_KEY is exactly spec-test-b2c-healthcare
# (and the API reports the same key). Scopes the scripts use (confirm against the real client, OA-01):
#   manage_products manage_categories manage_orders (cart/order cleanup) manage_project
#   (or the narrower manage_types manage_states manage_shipping_methods manage_tax_categories manage_stores)
SEED_CTP_PROJECT_KEY=
SEED_CTP_AUTH_URL=
SEED_CTP_API_URL=
SEED_CTP_CLIENT_ID=
SEED_CTP_CLIENT_SECRET=
SEED_CTP_SCOPES=

# Password given to the synthetic test patients created by the seed
SEED_PATIENT_PASSWORD=
