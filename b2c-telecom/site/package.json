{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:dev-routes": "node scripts/check-dev-routes.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:secrets && npm run check:lockfile && npm run check:versions && npm run check:tokens && npm run check:boundaries && npm run lint && npm run typecheck && npm test && npm run build && npm run check:dev-routes"
  },
  "dependencies": {
    "@commercetools/checkout-browser-sdk": "^1.7.5",
    "@commercetools/platform-sdk": "^8.27.0",
    "@commercetools/ts-client": "^4.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.2.6",
    "next-intl": "^4.14.9",
    "postcss": "^8.5.29",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
