# Seed/admin client for scripts/seed (OA-03). Never the storefront client. Copy to .env.seed; never commit .env.seed.
CTP_SEED_PROJECT_KEY=
CTP_SEED_AUTH_URL=
CTP_SEED_API_URL=
# SECRET.
CTP_SEED_CLIENT_ID=
# SECRET.
CTP_SEED_CLIENT_SECRET=
# Optional. Space-separated scopes sent with the token request.
CTP_SEED_SCOPES=
# Used by workstream G only (demo customers).
SEED_DEMO_PASSWORD=
